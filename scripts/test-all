#!/usr/bin/env python3
"""Run every discovered .NET test project in the TSQR workspace.

Usage:
    ./scripts/test-all
    ./scripts/test-all --repo tsqr-support
    ./scripts/test-all --repo tsqr-communities --repo tsqr-gateway
    ./scripts/test-all --filter "FullyQualifiedName~Handler"
    ./scripts/test-all --no-build

The script discovers tests/**/*.csproj in the affected repositories, so a new
test project is picked up automatically. It exits non-zero if any suite fails.
"""
from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

REPOS = [
    "tsqr-autheo",
    "tsqr-identity",
    "tsqr-tool-lib",
    "tsqr-communities",
    "tsqr-soup-kitchen",
    "tsqr-support",
    "tsqr-gateway",
]

WORKSPACE = Path(__file__).resolve().parents[2]


def discover(repo: str) -> list[Path]:
    test_root = WORKSPACE / repo / "tests"
    if not test_root.is_dir():
        return []
    return sorted(
        project
        for project in test_root.glob("**/*.csproj")
        if "bin" not in project.parts and "obj" not in project.parts
    )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--repo",
        action="append",
        choices=REPOS,
        help="Limit the run to a repository (repeatable).",
    )
    parser.add_argument("--filter", help="dotnet test --filter expression.")
    parser.add_argument(
        "--no-build",
        action="store_true",
        help="Skip the build step (dotnet test --no-build).",
    )
    args = parser.parse_args(argv)

    repos = args.repo or REPOS
    results: list[tuple[str, Path, int]] = []

    for repo in repos:
        repo_dir = WORKSPACE / repo
        if not repo_dir.is_dir():
            print(f"SKIP  {repo}: directory not found", file=sys.stderr)
            continue

        projects = discover(repo)
        if not projects:
            print(f"SKIP  {repo}: no test projects found", file=sys.stderr)
            continue

        for project in projects:
            relative = project.relative_to(repo_dir)
            print(f"\n=== {repo}/{relative} ===", flush=True)
            command = ["dotnet", "test", str(project), "--nologo", "-v", "minimal"]
            if args.no_build:
                command.append("--no-build")
            if args.filter:
                command.extend(["--filter", args.filter])
            completed = subprocess.run(command, cwd=repo_dir)
            results.append((repo, relative, completed.returncode))

    print("\n" + "=" * 64)
    print("Test summary")
    print("=" * 64)
    for repo, relative, code in results:
        status = "PASS" if code == 0 else "FAIL"
        print(f"{status}  {repo}/{relative}")

    failed = sum(1 for _, _, code in results if code != 0)
    print(f"\n{len(results) - failed} passed, {failed} failed, {len(results)} suite(s)")
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
